{
  "name": "dsh-sync-shuttle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "穿梭 · 同步中转：用邮箱当文件中转站，在不是同时开机的两台电脑之间同步目录",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sync",
    "imap",
    "file-transfer"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@zip.js/zip.js": "^2.25.0",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
